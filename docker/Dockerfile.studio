FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Crear usuario permitido por SageMaker Studio para operaciones con red.
RUN useradd -m -s /bin/bash sagemaker

# Copiamos primero dependencias para aprovechar cache.
COPY pyproject.toml uv.lock ./

# Damos permisos al usuario sagemaker.
RUN chown -R sagemaker:sagemaker /app /home/sagemaker

USER sagemaker

ENV PATH="/home/sagemaker/.local/bin:/home/sagemaker/.venv/bin:${PATH}"
ENV UV_PROJECT_ENVIRONMENT="/home/sagemaker/.venv"
ENV UV_LINK_MODE=copy

# Instalar uv sin curl ni apt-get.
RUN python -m pip install --user --upgrade pip uv

# Instalar dependencias del proyecto.
RUN uv sync --frozen --no-dev

COPY --chown=sagemaker:sagemaker app/ app/
COPY --chown=sagemaker:sagemaker src/ src/
COPY --chown=sagemaker:sagemaker sql/ sql/

EXPOSE 8501

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
